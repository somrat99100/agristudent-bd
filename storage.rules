rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function admin() { return verified() && request.auth.token.admin == true; }

    match /resources/{uid}/{fileName} {
      allow read: if verified() || admin();
      allow write: if verified() && request.auth.uid == uid
        && request.resource.size < 55 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|gif|webp)|application/(vnd.ms-powerpoint|vnd.openxmlformats-officedocument.presentationml.presentation)');
      allow delete: if verified() && request.auth.uid == uid || admin();
    }

    match /blog/{uid}/{fileName} {
      allow read: if verified() || admin();
      allow write: if verified() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if verified() && request.auth.uid == uid || admin();
    }

    match /student-ids/{uid}/{fileName} {
      allow read: if (verified() && request.auth.uid == uid) || admin();
      allow write: if (verified() && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')) || admin();
      allow delete: if (verified() && request.auth.uid == uid) || admin();
    }

    match /avatars/{uid}/{fileName} {
      allow read: if verified() || admin();
      allow write: if (verified() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')) || admin();
      allow delete: if (verified() && request.auth.uid == uid) || admin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
