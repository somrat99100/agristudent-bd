rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == 'iubatagriculture@gmail.com'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /registrations/{id} {
      allow create: if signedIn() && id == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'verified' &&
        request.resource.data.emailVerified == true &&
        request.resource.data.studentIdNumber is string && request.resource.data.studentIdNumber.size() > 0 && request.resource.data.studentIdNumber.size() < 50 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0;
      allow get: if admin() || owner(id);
      allow list: if admin();
      allow update: if admin() || (owner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl']) && request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.matches('^https://res[.]cloudinary[.]com/.*'));
      allow delete: if admin();
    }

    match /resources/{id} {
      allow create: if signedIn() && request.resource.data.uploaderUid == request.auth.uid &&
        request.resource.data.uploaderEmail == request.auth.token.email &&
        get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' &&
        (!('restrictedUntil' in get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data) || get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.restrictedUntil < request.time) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.resourceType in ['slides_notes','previous_questions'] &&
        request.resource.data.courseCode is string && request.resource.data.courseCode.size() > 0 &&
        request.resource.data.fileUrls is list && request.resource.data.fileUrls.size() > 0 && request.resource.data.fileUrls.size() <= 20;
      // Approved resources are shared content, not private uploader records.
      // Do NOT require uploaderUid for approved reads: this preserves access to
      // older approved resources created before UID ownership was introduced.
      allow get: if admin() || (signedIn() && resource.data.uploaderUid == request.auth.uid) || (signedIn() && resource.data.status == 'approved' && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' && (!('restrictedUntil' in get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data) || get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.restrictedUntil < request.time) && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.resourceAccessUntil > request.time));
      allow list: if admin() || (signedIn() && resource.data.uploaderUid == request.auth.uid) || (signedIn() && resource.data.status == 'approved' && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' && (!('restrictedUntil' in get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data) || get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.restrictedUntil < request.time) && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.resourceAccessUntil > request.time));
      allow update, delete: if admin();
    }

    match /terms/{id} {
      allow create: if signedIn() && request.resource.data.uploaderUid == request.auth.uid && request.resource.data.uploaderEmail == request.auth.token.email && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' && request.resource.data.status == 'pending' && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow get: if admin() || resource.data.status == 'approved' || owner(resource.data.uploaderUid);
      allow list: if admin() || resource.data.status == 'approved' || (signedIn() && resource.data.uploaderUid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /courses/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.courseCode is string && request.resource.data.courseCode.size() > 0 && request.resource.data.courseName is string;
      allow update, delete: if admin();
    }

    match /timeline/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','email','message']) && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 && (!('read' in request.resource.data) || request.resource.data.read == false);
      allow read, update, delete: if admin();
    }

    match /classroomCodes/{id} {
      allow create: if request.resource.data.keys().hasAll(['classroomCode','status']) && request.resource.data.classroomCode is string && request.resource.data.classroomCode.size() > 0 && request.resource.data.classroomCode.size() <= 200 && request.resource.data.status == 'new';
      allow read, update, delete: if admin();
    }

    match /settings/{id} { allow read: if true; allow write: if admin(); }

    match /blogPosts/{id} {
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorEmail == request.auth.token.email && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' && request.resource.data.status == 'pending' &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 20000 &&
        request.resource.data.likesCount == 0 && request.resource.data.commentsCount == 0 && request.resource.data.sharesCount == 0 && request.resource.data.views == 0;
      allow get: if admin() || resource.data.status == 'approved' || owner(resource.data.authorUid);
      allow list: if admin() || resource.data.status == 'approved' || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow update: if admin() || (owner(resource.data.authorUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','content','imageUrls','status','editedAt','editedBy']) && request.resource.data.status == 'pending_edit') || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) && (request.resource.data.likesCount == resource.data.likesCount + 1 || request.resource.data.likesCount == resource.data.likesCount - 1)) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) && request.resource.data.views == resource.data.views + 1) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount']) && request.resource.data.sharesCount == resource.data.sharesCount + 1) || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) && (request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1));
      allow delete: if admin() || owner(resource.data.authorUid);
    }

    match /blogComments/{id} {
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorEmail == request.auth.token.email && get(/databases/$(database)/documents/registrations/$(request.auth.uid)).data.status == 'verified' && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 && request.resource.data.postId is string && request.resource.data.postId.size() > 0;
      allow read: if true;
      allow update, delete: if admin() || owner(resource.data.authorUid);
    }

    match /blogLikes/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id == request.resource.data.postId + '_' + request.auth.uid;
      allow read: if true;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if false;
    }
  }
}
