rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function admin() { return verified() && request.auth.token.admin == true; }
    function student() { return verified() && request.auth.token.student == true && request.auth.token.regId is string; }
    function sameStudentReg(regId) { return student() && request.auth.token.regId == regId; }

    match /registrations/{id} {
      allow create: if false;
      allow get: if admin() || sameStudentReg(id);
      allow list: if admin();
      allow update: if admin() || (
        sameStudentReg(id) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'studentIdUrl', 'studentIdStoragePath']) &&
        (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string) &&
        (!('studentIdUrl' in request.resource.data) || request.resource.data.studentIdUrl is string) &&
        (!('studentIdStoragePath' in request.resource.data) || request.resource.data.studentIdStoragePath is string)
      );
      allow delete: if admin();
    }

    match /resources/{id} {
      allow read: if admin() || (student() && resource.data.privacyVersion == 2 && (
        resource.data.public == true ||
        resource.data.uploaderRegId == request.auth.token.regId
      ));
      allow create: if student() &&
        request.resource.data.keys().hasAll(['status','resourceType','courseCode','fileUrls','uploaderRegId','public','privacyVersion']) &&
        !request.resource.data.keys().hasAny(['uploaderEmail','uploaderStudentId','email','studentIdNumber']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.public == false &&
        request.resource.data.privacyVersion == 2 &&
        request.resource.data.resourceType in ['slides_notes','previous_questions'] &&
        request.resource.data.courseCode is string && request.resource.data.courseCode.size() > 0 && request.resource.data.courseCode.size() < 100 &&
        request.resource.data.uploaderRegId == request.auth.token.regId &&
        request.resource.data.fileUrls is list && request.resource.data.fileUrls.size() > 0 && request.resource.data.fileUrls.size() <= 20;
      allow update, delete: if admin();
    }

    match /terms/{id} {
      allow read: if admin() || (student() && resource.data.privacyVersion == 2 &&
        (resource.data.public == true || resource.data.uploaderRegId == request.auth.token.regId));
      allow create: if student() &&
        request.resource.data.keys().hasAll(['status','name','uploaderRegId','public','privacyVersion']) &&
        !request.resource.data.keys().hasAny(['uploaderEmail','email','studentIdNumber']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.public == false &&
        request.resource.data.privacyVersion == 2 &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.uploaderRegId == request.auth.token.regId;
      allow update, delete: if admin();
    }

    match /courses/{id} {
      allow read: if true;
      allow create: if (student() || admin()) &&
        request.resource.data.keys().hasAll(['courseCode','courseName']) &&
        request.resource.data.courseCode is string && request.resource.data.courseCode.size() > 0 && request.resource.data.courseCode.size() <= 50 &&
        request.resource.data.courseName is string && request.resource.data.courseName.size() > 0 && request.resource.data.courseName.size() <= 200;
      allow update, delete: if admin();
    }

    match /timeline/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /messages/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name','email','message']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000 &&
        (!('read' in request.resource.data) || request.resource.data.read == false);
      allow read, update, delete: if admin();
    }

    match /classroomCodes/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['classroomCode','status']) &&
        request.resource.data.classroomCode is string && request.resource.data.classroomCode.size() > 0 && request.resource.data.classroomCode.size() <= 200 &&
        request.resource.data.status == 'new';
      allow read, update, delete: if admin();
    }

    match /settings/{id} {
      allow read: if id == "semester";
      allow write: if admin();
    }

    match /blogPosts/{id} {
      allow read: if admin() || (student() && resource.data.privacyVersion == 2 && (
        resource.data.public == true ||
        resource.data.authorRegId == request.auth.token.regId
      ));
      allow create: if student() &&
        request.resource.data.keys().hasAll(['title','content','authorRegId','authorName','status','public','privacyVersion','likesCount','commentsCount','sharesCount','views']) &&
        !request.resource.data.keys().hasAny(['authorEmail','email','studentIdNumber']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.public == false &&
        request.resource.data.privacyVersion == 2 &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 20000 &&
        request.resource.data.authorRegId == request.auth.token.regId &&
        request.resource.data.likesCount == 0 && request.resource.data.commentsCount == 0 && request.resource.data.sharesCount == 0 && request.resource.data.views == 0;

      allow update: if admin() || (
        student() &&
        resource.data.authorRegId == request.auth.token.regId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','content','imageUrls','status','editedAt','editedBy','public']) &&
        request.resource.data.status == 'pending_edit' &&
        request.resource.data.public == false &&
        request.resource.data.privacyVersion == 2 &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 20000
      ) || (
        student() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) &&
        (request.resource.data.likesCount == resource.data.likesCount + 1 || request.resource.data.likesCount == resource.data.likesCount - 1)
      ) || (
        student() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1
      ) || (
        student() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount']) &&
        request.resource.data.sharesCount == resource.data.sharesCount + 1
      ) || (
        student() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']) &&
        (request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1)
      );

      allow delete: if admin() || (student() && resource.data.authorRegId == request.auth.token.regId);
    }

    match /blogComments/{id} {
      allow create: if student() &&
        request.resource.data.keys().hasAll(['postId','text','authorRegId','authorName','privacyVersion']) &&
        !request.resource.data.keys().hasAny(['authorEmail','email','studentIdNumber']) &&
        request.resource.data.postId is string && request.resource.data.postId.size() > 0 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.authorRegId == request.auth.token.regId && request.resource.data.privacyVersion == 2;
      allow read: if admin() || (student() && resource.data.privacyVersion == 2);
      allow update: if admin();
      allow delete: if admin() || (student() && resource.data.authorRegId == request.auth.token.regId);
    }

    match /blogLikes/{id} {
      allow create: if student() &&
        request.resource.data.keys().hasAll(['postId','uid']) &&
        request.resource.data.uid == request.auth.uid &&
        id == (request.resource.data.postId + '_' + request.auth.uid);
      allow read: if admin() || (student() && resource.data.uid == request.auth.uid);
      allow delete: if admin() || (student() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    match /privateResourceMeta/{id} { allow read, write: if admin(); }
    match /privateTermMeta/{id} { allow read, write: if admin(); }
    match /privateBlogMeta/{id} { allow read, write: if admin(); }
    match /privateCommentMeta/{id} { allow read, write: if admin(); }
    match /privateBlogLikeMeta/{id} { allow read, write: if admin(); }
    match /privateStudentIdMeta/{id} { allow read, write: if admin(); }

    match /otpChallenges/{id} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
